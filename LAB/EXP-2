
#include <stdio.h>
#include <string.h>

int main()
{
    char com[100];
    int len;

    printf("Enter the comment: ");
    fgets(com, sizeof(com), stdin);

    com[strcspn(com, "\n")] = '\0';

    len = strlen(com);

    if (len >= 2 && com[0] == '/' && com[1] == '/')
    {
        printf("It is a comment\n");
    }
    else if (len >= 4 &&
             com[0] == '/' && com[1] == '*' &&
             com[len - 2] == '*' && com[len - 1] == '/')
    {
        printf("It is a comment\n");
    }
    else
    {
        printf("It is not a comment\n");
    }

    return 0;
}
